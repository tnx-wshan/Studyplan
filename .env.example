# 앱 잠금 비밀번호 (배포 전에 반드시 강한 비밀번호로 바꾸세요)
APP_PASSWORD=change-me
# 세션 서명용 임의 문자열 (예: openssl rand -base64 32)
SESSION_SECRET=change-me-to-a-long-random-string

# ── AI 설정 ──
# 쓸 회사: gemini | claude | openai | mock(키 없이 테스트하는 가짜 AI)
AI_PROVIDER=gemini
# 쓰는 회사의 키 하나만 넣으면 돼요
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# 모델을 바꾸고 싶을 때만 (기본: gemini-3.5-flash / claude-sonnet-5-5 / gpt-5.5)
# AI_MODEL=
# 먼저 쓸 모델이 붐비거나 한도에 걸리면 대신 쓸 모델들 (쉼표로 구분, Gemini 기본: gemini-flash-lite-latest,gemini-flash-latest)
# AI_MODEL_FALLBACKS=
# 하루 사용 횟수 (기본: 튜터 30, 문제 만들기 10, 자료 정리 10, 코칭·피드백 10)
# AI_LIMIT_TUTOR=30
# AI_LIMIT_QUIZ=10
# AI_LIMIT_MATERIAL=10
# AI_LIMIT_COACH=10
