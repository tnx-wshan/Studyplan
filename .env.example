# 로그인 세션 서명용 임의 문자열 (예: openssl rand -base64 32). 학생은 화면에서 메일주소로 회원가입한다.
# 바꾸면 모든 기기의 로그인이 풀린다
SESSION_SECRET=change-me-to-a-long-random-string

# 같은 주소에서 1시간에 가입할 수 있는 횟수 (기본 10)
# SIGNUP_LIMIT_PER_HOUR=10

# ── AI 설정 ──
# 쓸 회사: gemini | claude | openai | mock(키 없이 테스트하는 가짜 AI)
AI_PROVIDER=gemini
# 쓰는 회사의 키 하나만 넣으면 돼요
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# 모델을 바꾸고 싶을 때만 (기본: gemini-3.5-flash / claude-sonnet-5-5 / gpt-5.5)
# AI_MODEL=
# 먼저 쓸 모델이 붐비거나 한도에 걸리면 대신 쓸 모델들 (쉼표로 구분, Gemini 기본: gemini-flash-lite-latest,gemini-flash-latest)
# AI_MODEL_FALLBACKS=
# 하루 사용 횟수 (기본: 튜터 30, 문제 만들기 10, 자료 정리 10, 코칭·피드백 10)
# AI_LIMIT_TUTOR=30
# AI_LIMIT_QUIZ=10
# AI_LIMIT_MATERIAL=10
# AI_LIMIT_COACH=10
# AI_LIMIT_UNIT=50      # 관리 도구의 'AI로 유닛 만들기'

# ── 관리 도구 ──
# 관리 도구는 같은 빌드를 다른 포트로 띄운 관리 서버에서만 열려요: npm run admin (기본 포트 3300)
# 학생이 쓰는 서버(npm start)에서는 /admin 주소가 없는 것처럼 보여요.
ADMIN_PASSWORD=change-me-admin
# ADMIN_PORT=3300
# 서버 DB 파일 이름 (.data 폴더 안, 기본 homestudy.db)
# HOMESTUDY_DB_NAME=homestudy.db
